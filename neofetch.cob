           PERFORM LEER-KER THRU FIN-KER.
           PERFORM LEER-PKGS THRU FIN-PKGS.
           PERFORM LEER-GPU THRU FIN-GPU.
           PERFORM LEER-DISK THRU FIN-DISK.
           PERFORM LEER-RES THRU FIN-RES.
           PERFORM LEER-GTK THRU FIN-GTK.
           PERFORM LEER-ICO THRU FIN-ICO.
           PERFORM LEER-HOSTM THRU FIN-HOSTM.
           IF WS-DE = SPACES
               MOVE "N/A (WSLg)" TO WS-DE.
           IF WS-WSL > 0
               MOVE "Weston (WSLg)" TO WS-WM
           ELSE
               MOVE "N/A" TO WS-WM.
           STRING FUNCTION TRIM(WS-USER) DELIMITED BY SIZE
               "@" DELIMITED BY SIZE
               FUNCTION TRIM(WS-HOST) DELIMITED BY SIZE
               INTO WS-UH.
           COMPUTE IMG-DN = IMG-HN - 22.
           MOVE IMG-HN TO IMG-HN-E.
           MOVE IMG-DN TO IMG-DN-E.
           DISPLAY ESC "[" FUNCTION TRIM(IMG-HN-E) "A" ESC "[42C" ESC C-BOLD ESC C-GREEN FUNCTION TRIM(WS-UH) ESC C-RESET WS-CR.
           DISPLAY ESC "[42C" "-------------------------" WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "SO        : " ESC C-RESET FUNCTION TRIM(WS-OS) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Host      : " ESC C-RESET FUNCTION TRIM(WS-HOSTM) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Kernel    : " ESC C-RESET FUNCTION TRIM(WS-KER) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Uptime    : " ESC C-RESET WS-HH-E " h " WS-MM-E " min" WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Paquetes  : " ESC C-RESET FUNCTION TRIM(WS-PKGS) " (pacman)" WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Shell     : " ESC C-RESET FUNCTION TRIM(WS-SHELL) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Resolucion: " ESC C-RESET FUNCTION TRIM(WS-RES) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "DE        : " ESC C-RESET FUNCTION TRIM(WS-DE) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "WM        : " ESC C-RESET FUNCTION TRIM(WS-WM) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Tema      : " ESC C-RESET FUNCTION TRIM(WS-THEME) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Iconos    : " ESC C-RESET FUNCTION TRIM(WS-ICON) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Terminal  : " ESC C-RESET FUNCTION TRIM(WS-TERM) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "CPU       : " ESC C-RESET FUNCTION TRIM(WS-CPU) " (" WS-CORESE ")" WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "GPU       : " ESC C-RESET FUNCTION TRIM(WS-GV) FUNCTION TRIM(WS-GD) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Memoria   : " ESC C-RESET WS-MEMU-E " / " WS-MEMT-E " MB (" WS-PCT-E "%)" WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Disco /   : " ESC C-RESET FUNCTION TRIM(WS-DU) " usados / " FUNCTION TRIM(WS-DA) " libres" WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Idioma    : " ESC C-RESET FUNCTION TRIM(WS-LANG) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Home      : " ESC C-RESET FUNCTION TRIM(WS-HOME) WS-CR.
           DISPLAY ESC "[42C" ESC C-BOLD ESC C-GREEN "Programador:" ESC C-RESET " srsaiet https://github.com/srsaiet" WS-CR.
           DISPLAY ESC "[42C" ESC "[40m   " ESC "[41m   " ESC "[42m   " ESC "[43m   " ESC "[44m   " ESC "[45m   " ESC "[46m   " ESC "[47m   " ESC C-RESET WS-CR.
           DISPLAY ESC "[42C" ESC "[100m   " ESC "[101m   " ESC "[102m   " ESC "[103m   " ESC "[104m   " ESC "[105m   " ESC "[106m   " ESC "[107m   " ESC C-RESET WS-CR.
           IF IMG-DN >= 0
               DISPLAY ESC "[" FUNCTION TRIM(IMG-DN-E) "B".
           STOP RUN.
       SYSINFO.
           CALL "SYSTEM" USING BY CONTENT C-PKGS.
           CALL "SYSTEM" USING BY CONTENT C-GPU.
           CALL "SYSTEM" USING BY CONTENT C-DISK.
           CALL "SYSTEM" USING BY CONTENT C-RES.
           CALL "SYSTEM" USING BY CONTENT C-GTK.
           CALL "SYSTEM" USING BY CONTENT C-ICO.
           CALL "SYSTEM" USING BY CONTENT C-HOST.
           PERFORM DECODE-B64 THRU FIN-DEC.
       LEER-HOST.
           OPEN INPUT HOSTNAM.
           READ HOSTNAM AT END GO TO FIN-HOST.
           MOVE F-HOST TO WS-HOST.
       FIN-HOST.
           CLOSE HOSTNAM.
       LEER-OS.
           OPEN INPUT OSREL.
       BUCLE-OS.
           READ OSREL AT END GO TO FIN-OS.
           IF F-OS(1:12) = "PRETTY_NAME="
               UNSTRING F-OS DELIMITED BY "=" INTO WS-T1 WS-T2
               INSPECT WS-T2 REPLACING ALL QUOTE BY SPACE
               MOVE FUNCTION TRIM(WS-T2) TO WS-OS
               GO TO FIN-OS.
           GO TO BUCLE-OS.
       FIN-OS.
           CLOSE OSREL.
       LEER-UP.
           OPEN INPUT UPTIMEF.
           READ UPTIMEF AT END GO TO FIN-UP.
           UNSTRING F-UP DELIMITED BY SPACE INTO WS-T1.
           COMPUTE WS-NUM = FUNCTION NUMVAL(WS-T1).
           DIVIDE 3600 INTO WS-NUM GIVING WS-HH REMAINDER WS-REM.
           DIVIDE 60 INTO WS-REM GIVING WS-MM.
           MOVE WS-HH TO WS-HH-E.
           MOVE WS-MM TO WS-MM-E.
       FIN-UP.
           CLOSE UPTIMEF.
       LEER-MEM.
           OPEN INPUT MEMINFO.
       BUCLE-MEM.
           READ MEMINFO AT END GO TO FIN-MEM.
           IF F-MEM(1:9) = "MemTotal:"
               UNSTRING F-MEM DELIMITED BY ALL SPACES INTO WS-T1 WS-T2
               COMPUTE WS-MEMT = FUNCTION NUMVAL(WS-T2) / 1024.
           IF F-MEM(1:13) = "MemAvailable:"
               UNSTRING F-MEM DELIMITED BY ALL SPACES INTO WS-T1 WS-T2
               COMPUTE WS-MEMA = FUNCTION NUMVAL(WS-T2) / 1024
               GO TO FIN-MEM.
           GO TO BUCLE-MEM.
       FIN-MEM.
           CLOSE MEMINFO.
           COMPUTE WS-MEMU = WS-MEMT - WS-MEMA.
           COMPUTE WS-PCT = WS-MEMU * 100 / WS-MEMT.
           MOVE WS-MEMT TO WS-MEMT-E.
           MOVE WS-MEMU TO WS-MEMU-E.
           MOVE WS-PCT TO WS-PCT-E.
       LEER-CPU.
           OPEN INPUT CPUINFO.
       BUCLE-CPU.
           READ CPUINFO AT END GO TO FIN-CPU.
           IF F-CPU(1:9) = "processor"
               ADD 1 TO WS-CORES.
           IF F-CPU(1:10) = "model name"
               IF WS-CPU = SPACES
                   UNSTRING F-CPU DELIMITED BY ":" INTO WS-T1 WS-T2
                   MOVE FUNCTION TRIM(WS-T2) TO WS-CPU.
           GO TO BUCLE-CPU.
       FIN-CPU.
           CLOSE CPUINFO.
           MOVE WS-CORES TO WS-CORESE.
       LEER-KER.
           OPEN INPUT PROCVER.
           READ PROCVER AT END GO TO FIN-KER.
           MOVE F-LINE TO WS-KERL.
           UNSTRING WS-KERL DELIMITED BY SPACE INTO WS-T1 WS-T2 WS-KER.
           INSPECT WS-KERL TALLYING WS-WSL FOR ALL "WSL".
       FIN-KER.
           CLOSE PROCVER.
       LEER-PKGS.
           OPEN INPUT PKGSF.
           READ PKGSF AT END GO TO FIN-PKGS.
           MOVE F-PKG TO WS-PKGS.
       FIN-PKGS.
           CLOSE PKGSF.
       LEER-GPU.
           OPEN INPUT GPUF.
           READ GPUF AT END GO TO FIN-GPU.
           UNSTRING F-GPU DELIMITED BY QUOTE INTO WS-T1 WS-T2 WS-JUNK WS-GV WS-GD.
           GO TO FIN-GPU.
       FIN-GPU.
           CLOSE GPUF.
           IF WS-GV = SPACES
               MOVE "Virtual (WSL2)" TO WS-GV.
       LEER-DISK.
           OPEN INPUT DISKF.
           READ DISKF AT END GO TO FIN-DISK.
           UNSTRING F-DSK DELIMITED BY ALL SPACES INTO WS-T1 WS-DU WS-DA.
       FIN-DISK.
           CLOSE DISKF.
       LEER-RES.
           OPEN INPUT RESF.
           READ RESF AT END GO TO FIN-RES.
           UNSTRING F-RES DELIMITED BY ALL SPACES INTO WS-T1 WS-RES.
           GO TO FIN-RES.
       FIN-RES.
           CLOSE RESF.
           IF WS-RES = SPACES
               MOVE "N/A (WSLg)" TO WS-RES.
       LEER-GTK.
           OPEN INPUT GTKF.
           READ GTKF AT END GO TO FIN-GTK.
           UNSTRING F-GTK DELIMITED BY "=" INTO WS-T1 WS-THEME.
       FIN-GTK.
           CLOSE GTKF.
           IF WS-THEME = SPACES
               MOVE "N/A" TO WS-THEME.
       LEER-ICO.
           OPEN INPUT ICONF.
           READ ICONF AT END GO TO FIN-ICO.
           UNSTRING F-ICO DELIMITED BY "=" INTO WS-T1 WS-ICON.
       FIN-ICO.
           CLOSE ICONF.
           IF WS-ICON = SPACES
               MOVE "N/A" TO WS-ICON.
       LEER-HOSTM.
           OPEN INPUT HOSTF.
           READ HOSTF AT END GO TO FIN-HOSTM.
           MOVE F-HST TO WS-HOSTM.
       FIN-HOSTM.
           CLOSE HOSTF.
           IF WS-HOSTM = SPACES
               IF WS-WSL > 0
                   MOVE "WSL2 (Windows)" TO WS-HOSTM
               ELSE
                   MOVE "Desconocido" TO WS-HOSTM.
       DECODE-B64.
           INITIALIZE OUT-TAB.
           MOVE 1 TO WS-L.
           MOVE 1 TO WS-CI.
           MOVE 1 TO WS-PT.
           PERFORM UNTIL WS-L > 3409
               MOVE B64-LIN(WS-L) TO WS-LINE
               MOVE 1 TO WS-G
               PERFORM UNTIL WS-G > 16
                   COMPUTE WS-P = (WS-G - 1) * 4 + 1
                   MOVE WS-LINE(WS-P:1) TO WS-C1
                   COMPUTE WS-P = WS-P + 1
                   MOVE WS-LINE(WS-P:1) TO WS-C2
                   COMPUTE WS-P = WS-P + 1
                   MOVE WS-LINE(WS-P:1) TO WS-C3
                   COMPUTE WS-P = WS-P + 1
                   MOVE WS-LINE(WS-P:1) TO WS-C4
                   MOVE WS-C1 TO WS-C
                   PERFORM SACAR-VALOR
                   MOVE WS-V TO WS-V1
                   MOVE WS-C2 TO WS-C
                   PERFORM SACAR-VALOR
                   MOVE WS-V TO WS-V2
                   MOVE WS-C3 TO WS-C
                   PERFORM SACAR-VALOR
                   MOVE WS-V TO WS-V3
                   MOVE WS-C4 TO WS-C
                   PERFORM SACAR-VALOR
                   MOVE WS-V TO WS-V4
                   IF WS-C4 = "="
                       IF WS-C3 = "="
                           PERFORM EMIT-1
                       ELSE
                           PERFORM EMIT-2
                       END-IF
                       MOVE 9999 TO WS-L
                       MOVE 99 TO WS-G
                   ELSE
                       PERFORM EMIT-3
                   END-IF
                   ADD 1 TO WS-G
               END-PERFORM
               ADD 1 TO WS-L
           END-PERFORM.
       FIN-DEC.
           DISPLAY FUNCTION TRIM(OUT-CHK(WS-CI) TRAILING) WITH NO ADVANCING.
       EMIT-3.
           COMPUTE WS-N = WS-V1 * 262144 + WS-V2 * 4096 + WS-V3 * 64 + WS-V4.
           DIVIDE 65536 INTO WS-N GIVING WS-B1 REMAINDER WS-R.
           DIVIDE 256 INTO WS-R GIVING WS-B2 REMAINDER WS-B3.
           COMPUTE WS-B1 = WS-B1 + 1.
           COMPUTE WS-B2 = WS-B2 + 1.
           COMPUTE WS-B3 = WS-B3 + 1.
           MOVE FUNCTION CHAR(WS-B1) TO WS-X1.
           MOVE FUNCTION CHAR(WS-B2) TO WS-X2.
           MOVE FUNCTION CHAR(WS-B3) TO WS-X3.
           MOVE WS-X1 TO OUT-CHK(WS-CI)(WS-PT:1).
           COMPUTE WS-PT = WS-PT + 1.
           MOVE WS-X2 TO OUT-CHK(WS-CI)(WS-PT:1).
           COMPUTE WS-PT = WS-PT + 1.
           MOVE WS-X3 TO OUT-CHK(WS-CI)(WS-PT:1).
           COMPUTE WS-PT = WS-PT + 1.
           IF WS-PT > 16500
               DISPLAY OUT-CHK(WS-CI) WITH NO ADVANCING
               ADD 1 TO WS-CI
               MOVE 1 TO WS-PT
           END-IF.
       EMIT-2.
           COMPUTE WS-N = WS-V1 * 262144 + WS-V2 * 4096.
           DIVIDE 65536 INTO WS-N GIVING WS-B1 REMAINDER WS-R.
           DIVIDE 256 INTO WS-R GIVING WS-B2.
           COMPUTE WS-B1 = WS-B1 + 1.
           COMPUTE WS-B2 = WS-B2 + 1.
           MOVE FUNCTION CHAR(WS-B1) TO WS-X1.
           MOVE FUNCTION CHAR(WS-B2) TO WS-X2.
           MOVE WS-X1 TO OUT-CHK(WS-CI)(WS-PT:1).
           COMPUTE WS-PT = WS-PT + 1.
           MOVE WS-X2 TO OUT-CHK(WS-CI)(WS-PT:1).
           COMPUTE WS-PT = WS-PT + 1.
       EMIT-1.
           COMPUTE WS-N = WS-V1 * 262144.
           DIVIDE 65536 INTO WS-N GIVING WS-B1.
           COMPUTE WS-B1 = WS-B1 + 1.
           MOVE FUNCTION CHAR(WS-B1) TO WS-X1.
           MOVE WS-X1 TO OUT-CHK(WS-CI)(WS-PT:1).
           COMPUTE WS-PT = WS-PT + 1.
       SACAR-VALOR.
           IF WS-C >= "A"
               IF WS-C <= "Z"
                   COMPUTE WS-V = FUNCTION ORD(WS-C) - FUNCTION ORD("A")
               END-IF
           END-IF.
           IF WS-C >= "a"
               IF WS-C <= "z"
                   COMPUTE WS-V = FUNCTION ORD(WS-C) - FUNCTION ORD("a") + 26
               END-IF
           END-IF.
           IF WS-C >= "0"
               IF WS-C <= "9"
                   COMPUTE WS-V = FUNCTION ORD(WS-C) - FUNCTION ORD("0") + 52
               END-IF
           END-IF.
           IF WS-C = "+"
               MOVE 62 TO WS-V
           END-IF.
           IF WS-C = "/"
               MOVE 63 TO WS-V
           END-IF.
